{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/spa"
      }
    }
  ],
  "routes": [
    {
      "src": "/.well-known/apple-developer-merchantid-domain-association",
      "dest": "/api/apple-pay-domain-association"
    },
    {
      "src": "/((?!assets/)(?!.well-known/)(?!api/).*)",
      "dest": "/index.html"
    }
  ]
}
