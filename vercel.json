{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/spa"
      }
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Encoding",
          "value": "identity"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, no-transform"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "CF-Cache-Status",
          "value": "BYPASS"
        }
      ]
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Encoding",
          "value": "identity"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, no-transform"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "/api/.well-known/apple-developer-merchantid-domain-association"
    },
    {
      "source": "/((?!assets/)(?!api/)(?!.well-known/).*)",
      "destination": "/index.html"
    }
  ]
}
