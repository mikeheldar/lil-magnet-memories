# Environment Variables for Lil Magnet Memories
# Copy this file to .env and fill in your actual values

# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Square Payment Configuration
# Get these from: https://developer.squareup.com/apps
VITE_SQUARE_APPLICATION_ID=sandbox-sq0idb-YOUR-ID-HERE
VITE_SQUARE_LOCATION_ID=YOUR-LOCATION-ID-HERE

# PayPal Configuration (Optional)
VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID

# Google Reviews Integration
# Option 1 (Recommended): Use Google's short review URL from your Business Profile
# Get it from: https://business.google.com/ → Get more reviews → Share review form
# Example: https://g.page/r/YOUR_CODE_HERE/review
VITE_GOOGLE_REVIEW_URL=https://g.page/r/CYtlxEZ_NAz4EBM/review

# Google Places API (for fetching and displaying Google reviews on your site)
# Get API key from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable "Places API (New)" or "Places API" for this key
# IMPORTANT: Restrict this key to your domain and specific APIs
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Optional: same key for Vercel serverless /api/google-reviews (preferred over VITE_ on server)
GOOGLE_PLACES_API_KEY=

# Google Places API for Test Environment (optional, falls back to production key if not set)
# Use a separate API key for test environment with test.lilmagnetmemories.com restrictions
VITE_GOOGLE_PLACES_API_KEY_TEST=your_test_google_places_api_key_here

# Place ID (used by both review link and Places API)
# Get your Place ID from: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# Copy-paste carefully: uppercase "I" and lowercase "L" look identical in many fonts (e.g. ...Blk... not ...BIk...).
VITE_GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxx

# Instagram blog sync (Firebase Cloud Functions — NOT frontend env vars)
# Set on each Firebase project (test + production) via:
#   npx firebase-tools functions:config:set instagram.user_id="YOUR_IG_BUSINESS_ACCOUNT_ID" meta.page_access_token="YOUR_PAGE_ACCESS_TOKEN" --project YOUR_PROJECT_ID
# Then redeploy: npx firebase-tools deploy --only functions:api --project YOUR_PROJECT_ID
# Get credentials from Meta Business Suite → your Facebook Page → Instagram account linked to the page.
# Page access token needs instagram_basic (and pages_read_engagement) permissions.

# Instructions:
# 1. Sign up at https://www.emailjs.com/ for EmailJS
# 2. Set up Gmail service and get Service ID
# 3. Create email template and get Template ID
# 4. Get Public Key from Account settings
# 5. For Square: See SQUARE_PAYMENT_SETUP.md for detailed instructions
# 6. For Google Reviews: See GOOGLE_REVIEWS_SETUP.md for detailed instructions
# 7. Never commit this file to version control
